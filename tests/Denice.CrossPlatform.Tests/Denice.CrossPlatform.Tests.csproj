<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ONE OS-agnostic spec test project for IPlatformFileSystem. Its tests assert the spec through the
       interface and never branch on OS; the per-OS impl under test is selected by the shared platform-selection
       import (keyed on RuntimeIdentifier, falling back to the build-host OS) — the same mechanism the engine uses —
       so the same tests validate each platform's implementation in its own CI leg. This project is deliberately NOT
       one of the four Denice.CrossPlatform.* libraries the interop/OS-branching analyzers exempt, so the spec
       code itself stays OS-agnostic. -->
  <PropertyGroup>
    <DeniceIsTestProject>true</DeniceIsTestProject>
    <RootNamespace>Denice.CrossPlatform.Tests</RootNamespace>
    <AssemblyName>Denice.CrossPlatform.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denice.TestHelpers\Denice.TestHelpers.csproj" />
  </ItemGroup>

  <!-- The real code-signature fixtures (signed with throwaway self-signed certificates by Fixtures/CodeSignature/
       make-fixtures.sh), copied beside the test assembly so CodeSignatureSpecTests reads them from the base directory. -->
  <ItemGroup>
    <None Include="Fixtures/CodeSignature/**" Exclude="Fixtures/CodeSignature/make-fixtures.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The target RID, threaded to the per-OS implementation selection below (RID first, build-host OS fallback). -->
  <PropertyGroup>
    <DenicePlatformRid Condition="'$(DenicePlatformRid)' == ''">$(RuntimeIdentifier)</DenicePlatformRid>
  </PropertyGroup>

  <!-- References the contract always and exactly one per-OS impl, selected by RuntimeIdentifier / build-host OS. -->
  <Import Project="../../src/Denice.CrossPlatform/PlatformImplementation.targets" />

</Project>
