<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ONE OS-agnostic spec test project for IPlatformFileSystem. Its tests assert the spec through the
       interface and never branch on OS; the per-OS impl under test is selected by the shared platform-selection
       import (keyed on RuntimeIdentifier, falling back to the build-host OS) — the same mechanism the engine uses —
       so the same tests validate each platform's implementation in its own CI leg. This project is deliberately NOT
       one of the four Denice.CrossPlatform.* libraries the interop/OS-branching analyzers exempt, so the spec
       code itself stays OS-agnostic. -->
  <PropertyGroup>
    <DeniceIsTestProject>true</DeniceIsTestProject>
    <RootNamespace>Denice.CrossPlatform.Tests</RootNamespace>
    <AssemblyName>Denice.CrossPlatform.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Denice.TestHelpers\Denice.TestHelpers.csproj" />
  </ItemGroup>

  <!-- The real code-signature fixtures (signed with throwaway self-signed certificates by Fixtures/CodeSignature/
       make-fixtures.sh), copied beside the test assembly so CodeSignatureSpecTests reads them from the base directory. -->
  <ItemGroup>
    <None Include="Fixtures/CodeSignature/**" Exclude="Fixtures/CodeSignature/make-fixtures.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The target RID, threaded to the per-OS implementation selection below (RID first, build-host OS fallback). -->
  <PropertyGroup>
    <DenicePlatformRid Condition="'$(DenicePlatformRid)' == ''">$(RuntimeIdentifier)</DenicePlatformRid>
  </PropertyGroup>

  <!-- References the contract always and exactly one per-OS impl, selected by RuntimeIdentifier / build-host OS. -->
  <Import Project="../../src/Denice.CrossPlatform/PlatformImplementation.targets" />

  <ItemGroup Condition="!$(DenicePlatformRid.StartsWith('osx')) and !('$(DenicePlatformRid)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
    <Compile Remove="RecordingSpecTests.MacOS.cs" />
    <Compile Remove="DesktopExecutionTests.MacOS.cs" />
  </ItemGroup>

  <!-- Cocoa fixtures execute on a child process main thread within this existing test assembly. -->
  <PropertyGroup Condition="$(DenicePlatformRid.StartsWith('osx')) or ('$(DenicePlatformRid)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
    <OutputType>Exe</OutputType>
    <StartupObject>Denice.CrossPlatform.Tests.DesktopExecutionTests</StartupObject>
    <!-- CEF derives its macOS helper path from the executable's enclosing application bundle. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/Denice.CrossPlatform.Tests.app/Contents/MacOS/</OutputPath>
  </PropertyGroup>

  <Target Name="WriteMacDesktopFixtureBundle" AfterTargets="Build" Condition="'$(StartupObject)' == 'Denice.CrossPlatform.Tests.DesktopExecutionTests'">
    <WriteLinesToFile File="$(OutputPath)../Info.plist" Overwrite="true"
      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&lt;plist version=&quot;1.0&quot;&gt;&lt;dict&gt;&lt;key&gt;CFBundleExecutable&lt;/key&gt;&lt;string&gt;Denice.CrossPlatform.Tests&lt;/string&gt;&lt;key&gt;CFBundleIdentifier&lt;/key&gt;&lt;string&gt;ai.denice.desktop-tests&lt;/string&gt;&lt;key&gt;CFBundlePackageType&lt;/key&gt;&lt;string&gt;APPL&lt;/string&gt;&lt;/dict&gt;&lt;/plist&gt;" />
  </Target>

  <!-- Windows desktop behavior that needs no graphics adapter runs on every Windows test leg. -->
  <ItemGroup Condition="!$(DenicePlatformRid.StartsWith('win')) and !('$(DenicePlatformRid)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
    <Compile Remove="DesktopBehaviorTests.Windows.cs" />
  </ItemGroup>

  <!-- Native GPU proof is explicitly selected on a Windows graphics runner, not ordinary unit-test hosts. -->
  <ItemGroup Condition="'$(DeniceDesktopGpuTests)' != 'true' or !$(DenicePlatformRid.StartsWith('win'))">
    <Compile Remove="DesktopGpuTests.Windows.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DeniceDesktopGpuTests)' != 'true' or !$(DenicePlatformRid.StartsWith('linux'))">
    <Compile Remove="DesktopGpuTests.Linux.cs" />
  </ItemGroup>

  <!-- Linux unit tests that need no graphics device run on every Linux test leg (RID first, build-host OS fallback). -->
  <ItemGroup Condition="!$(DenicePlatformRid.StartsWith('linux')) and !('$(DenicePlatformRid)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
    <Compile Remove="DmaBufAttributesTests.Linux.cs" />
    <Compile Remove="CudaAbiTests.Linux.cs" />
    <Compile Remove="DesktopBehaviorTests.Linux.cs" />
  </ItemGroup>

</Project>
