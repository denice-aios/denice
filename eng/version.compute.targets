<Project>

  <!--
    Build-id resolution, shared by the pre-solution target (Directory.Solution.targets) and the per-project
    fallback (Directory.Build.targets). The Day/Time math lives here once (the authorized bash mirror is
    eng/compute-build-id.sh).

    DeniceResolveVersion fills DeniceDay/Time/Combined/Hash when they were not supplied as args (A):
      1. If a generated file already exists this build (written by the pre-solution target B, or by the first
         project in a non-solution build C), READ it — so every project in one build shares the one id.
      2. Otherwise compute the id once and WRITE the file, so the rest of this build reads the same value.
  -->

  <PropertyGroup>
    <DeniceVersionFile>$(MSBuildThisFileDirectory)obj/version.g.props</DeniceVersionFile>
  </PropertyGroup>

  <Target Name="DeniceResolveVersion" Condition="'$(DeniceDay)' == ''">
    <!-- 1. Prefer a file already written this build (shared id). -->
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceDay/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceDay" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceTime/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceTime" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceCombined/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceCombined" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceHash/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceHash" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceTag/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceTag" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(DeniceVersionFile)" Query="/Project/PropertyGroup/DeniceVersion/text()" Condition="Exists('$(DeniceVersionFile)')">
      <Output TaskParameter="Result" PropertyName="DeniceVersion" />
    </XmlPeek>

    <!-- 2. No file yet: compute once and write it so the rest of this build shares it. -->
    <CallTarget Targets="DeniceComputeAndWriteVersion" Condition="'$(DeniceDay)' == ''" />
  </Target>

  <Target Name="DeniceComputeAndWriteVersion" DependsOnTargets="DeniceComputeCore">
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj" />
    <ItemGroup>
      <_AgLine Include="&lt;Project&gt;" />
      <_AgLine Include="  &lt;PropertyGroup&gt;" />
      <_AgLine Include="    &lt;DeniceDay&gt;$(_AgDay)&lt;/DeniceDay&gt;" />
      <_AgLine Include="    &lt;DeniceTime&gt;$(_AgTime)&lt;/DeniceTime&gt;" />
      <_AgLine Include="    &lt;DeniceCombined&gt;$(_AgCombined)&lt;/DeniceCombined&gt;" />
      <_AgLine Include="    &lt;DeniceHash&gt;$(_AgHash)&lt;/DeniceHash&gt;" />
      <_AgLine Include="    &lt;DeniceTag&gt;$(_AgTag)&lt;/DeniceTag&gt;" />
      <_AgLine Include="    &lt;DeniceVersion&gt;$(_AgVersion)&lt;/DeniceVersion&gt;" />
      <_AgLine Include="  &lt;/PropertyGroup&gt;" />
      <_AgLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <!-- Write to a temp file then atomically move, so a concurrent reader never sees a torn/partial file. -->
    <WriteLinesToFile File="$(DeniceVersionFile).tmp" Lines="@(_AgLine)" Overwrite="true" />
    <Move SourceFiles="$(DeniceVersionFile).tmp" DestinationFiles="$(DeniceVersionFile)" OverwriteReadOnlyFiles="true" />
    <PropertyGroup>
      <DeniceDay>$(_AgDay)</DeniceDay>
      <DeniceTime>$(_AgTime)</DeniceTime>
      <DeniceCombined>$(_AgCombined)</DeniceCombined>
      <DeniceHash>$(_AgHash)</DeniceHash>
      <DeniceTag>$(_AgTag)</DeniceTag>
      <DeniceVersion>$(_AgVersion)</DeniceVersion>
    </PropertyGroup>
  </Target>

  <!-- The one MSBuild copy of the Day/Time/Combined/hash formula AND the assembled tag/SemVer (the CI-side mirror
       is eng/compute-build-id.sh). The -pre-release suffix (channel-by-prerelease-id) is applied ONLY here on the
       local side; no stamp target, project, or job re-joins the string (compute-version-once). -->
  <Target Name="DeniceComputeCore">
    <PropertyGroup>
      <!-- Read the clock ONCE so Day and Time can never come from two different instants at the day boundary. -->
      <_AgTicks>$([System.DateTime]::UtcNow.Ticks)</_AgTicks>
      <_AgDay>$([System.DateTime]::new($(_AgTicks)).Subtract($([System.DateTime]::new(2020,1,1))).Days)</_AgDay>
      <_AgTime>$([System.Convert]::ToInt32($([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::new($(_AgTicks)).TimeOfDay.TotalSeconds), 2))))))</_AgTime>
      <_AgCombined>$([MSBuild]::Add($([MSBuild]::Multiply($(_AgDay), 43200)), $(_AgTime)))</_AgCombined>
    </PropertyGroup>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AgHash" />
      <Output TaskParameter="ExitCode" PropertyName="_AgGitRc" />
    </Exec>
    <PropertyGroup>
      <_AgHash Condition="'$(_AgGitRc)' != '0' or '$(_AgHash)' == ''">local</_AgHash>
      <_AgPre Condition="'$(DeniceChannel)' == 'dev'">-pre-release</_AgPre>
      <_AgTag>$(DeniceMajorMinor).$(_AgCombined)$(_AgPre)</_AgTag>
      <_AgVersion>$(_AgTag)+$(_AgHash)</_AgVersion>
    </PropertyGroup>
  </Target>

</Project>
