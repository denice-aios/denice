<Project>

  <!--
    Strong-naming + signed/unsigned build selection (decisions 20, 21, 35).

    Signed build   = the strong-name key is present (the git-ignored local key from eng/generate-dev-keys,
                     or a path a CI job points at). Assemblies are strong-named and the InternalsVisibleTo
                     declarations get the public key injected.
    Unsigned build = no key present. The build proceeds UNSIGNED (decision 20, reversed): InternalsVisibleTo
                     stays keyless and nothing is strong-named, so a developer can build with no keys at all.
    DENICE_REQUIRE_SIGNED (set in CI) turns a missing key into a hard failure, so CI never ships unsigned.

    The analyzer and its tests (DeniceIsAnalyzerProject) are excluded: the Roslyn analyzer stays
    netstandard2.0 and unsigned, and that folder is out of scope here.
  -->

  <PropertyGroup Condition="'$(DeniceIsAnalyzerProject)' != 'true'">
    <!-- Key locations. CI overrides these to point at secret-provided material. -->
    <DeniceKeyDir Condition="'$(DeniceKeyDir)' == ''">$(MSBuildThisFileDirectory)signing/local</DeniceKeyDir>
    <DeniceStrongNameKey Condition="'$(DeniceStrongNameKey)' == ''">$(DeniceKeyDir)/denice-strongname.snk</DeniceStrongNameKey>
    <DenicePublicKeyFile Condition="'$(DenicePublicKeyFile)' == ''">$(DeniceKeyDir)/denice-strongname.publickey</DenicePublicKeyFile>

    <!-- Signed iff the strong-name key file exists (unless a caller forced the value). -->
    <DeniceSigned Condition="'$(DeniceSigned)' == '' and Exists('$(DeniceStrongNameKey)')">true</DeniceSigned>
    <DeniceSigned Condition="'$(DeniceSigned)' == ''">false</DeniceSigned>
  </PropertyGroup>

  <!-- CI safety net (decision 20): required-signed but no key => fail hard, never silently unsigned. -->
  <Target Name="DeniceRequireSignedGuard"
          BeforeTargets="BeforeBuild"
          Condition="'$(DENICE_REQUIRE_SIGNED)' == 'true' and '$(DeniceSigned)' != 'true' and '$(DeniceIsAnalyzerProject)' != 'true'">
    <Error Text="DENICE_REQUIRE_SIGNED is set but no strong-name key was found at '$(DeniceStrongNameKey)'. Run eng/generate-dev-keys.sh (macOS/Linux) or eng/generate-dev-keys.ps1 (Windows), or provide the CI signing key. CI must never ship an unsigned build." />
  </Target>

  <!-- Turn on strong-naming when signed. -->
  <PropertyGroup Condition="'$(DeniceSigned)' == 'true' and '$(DeniceIsAnalyzerProject)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(DeniceStrongNameKey)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    InternalsVisibleTo transform (decision 35): source keeps plain <InternalsVisibleTo Include="X" /> with no
    key. On a signed build this target reads the public key and stamps it onto every such item before the SDK
    turns them into assembly attributes, so a strong-named friend reference is valid. On an unsigned build the
    target does nothing and the friend reference stays keyless.
  -->
  <Target Name="DeniceInjectStrongNameKey"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(DeniceSigned)' == 'true' and '@(InternalsVisibleTo)' != ''">
    <PropertyGroup>
      <DenicePublicKey>$([System.IO.File]::ReadAllText('$(DenicePublicKeyFile)').Trim())</DenicePublicKey>
    </PropertyGroup>
    <ItemGroup>
      <InternalsVisibleTo Update="@(InternalsVisibleTo)" Key="$(DenicePublicKey)" />
    </ItemGroup>
  </Target>

</Project>
