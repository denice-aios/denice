<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Denice.app (pkg-697310396f74 macos-bundle: "App beside versions"): the app holds only the loader; the versions
     live beside it in ~/Applications/Denice/versions/. eng/build-install-layout.sh fills @VERSION@ and @SHORT_VERSION@. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>ai.denice.Denice</string>
  <key>CFBundleName</key>
  <string>Denice</string>
  <key>CFBundleDisplayName</key>
  <string>Denice</string>
  <key>CFBundleExecutable</key>
  <string>denice</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 Denice.ai</string>
</dict>
</plist>
