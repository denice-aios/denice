<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows per-OS impl assembly. Authors its own source under Windows/ (the CreateFileW +
       DeviceIoControl(FSCTL_SET_REPARSE_POINT) bindings for the in-place atomic re-point, the IPlatformFileSystem
       implementation, and the self-building PlatformServices.Create factory); it does NOT link the POSIX source
       because a version pointer is a directory symlink that cannot be re-pointed by a rename, so it rewrites the
       existing link's reparse data in place instead. The [LibraryImport] source generator for these P/Invokes
       requires unsafe blocks. One of the four Denice.CrossPlatform.* libraries the interop/OS-branching analyzers
       (DN0008/DN0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>Denice.CrossPlatform.Windows</RootNamespace>
    <AssemblyName>Denice.CrossPlatform.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Denice.Abstractions/Denice.Abstractions.csproj" />
    <ProjectReference Include="../Denice.CrossPlatform/Denice.CrossPlatform.csproj" />
  </ItemGroup>

  <!-- The OS-agnostic browser mixer core (approved shared mixer refactor, windows-linux-audio-proof.md): authored once under
       Denice.CrossPlatform.MacOS/Browser and compile-linked here, like the POSIX source; macOS adds its own output. -->
  <ItemGroup>
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IMixerOutput.cs" Link="Browser/Shared/IMixerOutput.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IMixerRender.cs" Link="Browser/Shared/IMixerRender.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IRedirectedSource.cs" Link="Browser/Shared/IRedirectedSource.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerClaim.cs" Link="Browser/Shared/MixerClaim.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerCore.cs" Link="Browser/Shared/MixerCore.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerOutputStart.cs" Link="Browser/Shared/MixerOutputStart.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixedAudioQueue.cs" Link="Browser/Shared/MixedAudioQueue.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/SpeechQueue.cs" Link="Browser/Shared/SpeechQueue.cs" />
  </ItemGroup>

  <!-- PlatformServices.Create() is internal (platform-create-internal); Denice.Engine reaches this one door
       through the grant, and only from SystemServices.Create() (DN0029); the grant moved here from
       Denice.Boundaries with the container itself. Keyless in source; the signing target injects the public key
       on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Denice.Engine" />
    <InternalsVisibleTo Include="Denice.CrossPlatform.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <DeniceDesktopPlatform>win</DeniceDesktopPlatform>
  </PropertyGroup>
  <Import Project="../../eng/desktop-native.targets" />

</Project>
