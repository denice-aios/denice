<Project Sdk="Microsoft.NET.Sdk">

  <!-- Denice Runtime's side of the loader protocol (eng/loader-protocol.json): recognising that the loader started
       this version, recording that it started, and (in later pieces) downloading, checking and installing newer
       versions. Tim, 14 November 2026: "The .NET DLL performs the downloading". It reaches the OS only through the
       owned services in Denice.Abstractions. -->
  <PropertyGroup>
    <RootNamespace>Denice.Updates</RootNamespace>
    <AssemblyName>Denice.Updates</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Denice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Denice.Abstractions/Denice.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sigstore" />
  </ItemGroup>

  <!-- Sigstore's public trusted root, shipped inside Denice Runtime so a release check never fetches trust material
       (pkg-471f394bb261). Source: github.com/sigstore/root-signing targets/trusted_root.json, taken 16 November 2026;
       a Denice release carries a newer copy when Sigstore rotates its keys. -->
  <ItemGroup>
    <EmbeddedResource Include="SigstoreTrustedRoot.json" LogicalName="Denice.Updates.SigstoreTrustedRoot.json" />
  </ItemGroup>

</Project>
