<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OS-uniform boundary layer: the EnvironmentAdapter/ConsoleAdapter owners and the IBuildInfo owner (boundaries-assembly). It references Denice.Abstractions and nothing else. The concrete
       ISystemServices container and the one SystemServices.Create() composition factory now live in
       Denice.Engine, which is why this project no longer selects a per-OS implementation: the three adapters here
       reach neither Denice.CrossPlatform nor any per-OS assembly. The file-op adapters and GuidFactory live in
       Denice.CrossPlatform (owners-live-at-lowest-consumer). -->
  <PropertyGroup>
    <RootNamespace>Denice.Boundaries</RootNamespace>
    <AssemblyName>Denice.Boundaries</AssemblyName>
  </PropertyGroup>

  <!-- The three adapters and their factories are internal (Wall 1). Denice.Engine reaches them through this one
       grant, and only from SystemServices.Create() and only as one of the three permitted factory identities (DN0040).
       This replaces the earlier grants to the CLI ("denice") and the test SystemServicesBuilder: both now reach the
       container through Denice.Engine's own grants instead, so nothing but Engine sees a Boundaries internal.
       Keyless in source; the signing target injects the public key on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Denice.Engine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Denice.Abstractions/Denice.Abstractions.csproj" />
  </ItemGroup>

</Project>
