<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux per-OS impl assembly. It carries NO POSIX source of its own: the same libc rename serves both kernels,
       so it <Compile Include=… Link=…>-shares the single authored MacOS POSIX source across project directories —
       ONE source, linked mac -> linux, NOT duplicated and NOT collapsed to a shared base class. A real second copy
       would compile the same type+namespace twice into one assembly (a duplicate-type build error), so the
       compiler itself forbids the copy. The [LibraryImport] source generator requires unsafe blocks. One of the
       four Denice.CrossPlatform.* libraries the interop/OS-branching analyzers (DN0008/DN0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>Denice.CrossPlatform.Linux</RootNamespace>
    <AssemblyName>Denice.CrossPlatform.Linux</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Denice.Abstractions/Denice.Abstractions.csproj" />
    <ProjectReference Include="../Denice.CrossPlatform/Denice.CrossPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Denice.CrossPlatform.MacOS/Posix/PosixNativeMethods.cs" Link="Posix/PosixNativeMethods.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Posix/PosixFileSystem.cs" Link="Posix/PosixFileSystem.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Posix/PlatformServices.cs" Link="Posix/PlatformServices.cs" />
  </ItemGroup>

  <!-- The OS-agnostic browser mixer core (approved shared mixer refactor, windows-linux-audio-proof.md): authored once under
       Denice.CrossPlatform.MacOS/Browser and compile-linked here, like the POSIX source; macOS adds its own output. -->
  <ItemGroup>
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IMixerOutput.cs" Link="Browser/Shared/IMixerOutput.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IMixerRender.cs" Link="Browser/Shared/IMixerRender.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/IRedirectedSource.cs" Link="Browser/Shared/IRedirectedSource.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerClaim.cs" Link="Browser/Shared/MixerClaim.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerCore.cs" Link="Browser/Shared/MixerCore.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixerOutputStart.cs" Link="Browser/Shared/MixerOutputStart.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/MixedAudioQueue.cs" Link="Browser/Shared/MixedAudioQueue.cs" />
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/SpeechQueue.cs" Link="Browser/Shared/SpeechQueue.cs" />
  </ItemGroup>

  <!-- The compile-selected browser-audio redirection proof (DeniceAudioRedirectionProof, windows-linux-audio-proof.md);
       normal builds compile none of Browser/Proof. Browser/Proof/Shared is linked into the Windows proof as well. -->
  <PropertyGroup Condition="'$(DeniceAudioRedirectionProof)' == 'true'">
    <DefineConstants>$(DefineConstants);DENICE_AUDIO_REDIRECTION_PROOF</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeniceAudioRedirectionProof)' != 'true'">
    <Compile Remove="Browser/Proof/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeniceAudioRedirectionProof)' == 'true'">
    <Compile Include="../Denice.CrossPlatform.MacOS/Browser/LinearResampler.cs" Link="Browser/Shared/LinearResampler.cs" />
  </ItemGroup>

  <!-- PlatformServices.Create() is internal (platform-create-internal); Denice.Engine reaches this one door
       through the grant, and only from SystemServices.Create() (DN0029); the grant moved here from
       Denice.Boundaries with the container itself. Keyless in source; the signing target injects the public key
       on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Denice.Engine" />
    <InternalsVisibleTo Include="Denice.CrossPlatform.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <DeniceDesktopPlatform>linux</DeniceDesktopPlatform>
  </PropertyGroup>
  <Import Project="../../eng/desktop-native.targets" />

</Project>
