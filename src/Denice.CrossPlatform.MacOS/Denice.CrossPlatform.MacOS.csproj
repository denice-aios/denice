<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS per-OS impl assembly. Authors the shared POSIX source under Posix/ (the libc rename binding, the
       IPlatformFileSystem implementation, and the self-building PlatformServices.Create factory). The Linux impl
       link-shares these same files (see Denice.CrossPlatform.Linux.csproj); Windows authors its own. The
       [LibraryImport] source generator for the rename P/Invoke requires unsafe blocks. One of the four
       Denice.CrossPlatform.* libraries the interop/OS-branching analyzers (DN0008/DN0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>Denice.CrossPlatform.MacOS</RootNamespace>
    <AssemblyName>Denice.CrossPlatform.MacOS</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Browser audio diagnostics build (event log, cycle ring, per-stream counters); never set in the normal build. -->
  <PropertyGroup Condition="'$(DeniceAudioDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);DENICE_AUDIO_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Denice.Abstractions/Denice.Abstractions.csproj" />
    <ProjectReference Include="../Denice.CrossPlatform/Denice.CrossPlatform.csproj" />
  </ItemGroup>


  <!-- PlatformServices.Create() is internal (platform-create-internal); Denice.Engine reaches this one door
       through the grant, and only from SystemServices.Create() (DN0029); the grant moved here from
       Denice.Boundaries with the container itself. Keyless in source; the signing target injects the public key
       on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Denice.Engine" />
    <InternalsVisibleTo Include="Denice.CrossPlatform.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <DeniceDesktopPlatform>osx</DeniceDesktopPlatform>
  </PropertyGroup>
  <Import Project="../../eng/desktop-native.targets" />

</Project>
