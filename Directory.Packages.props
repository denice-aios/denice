<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DeniceCefVersion>156.0.15</DeniceCefVersion>
    <DeniceSkiaVersion>4.157.0</DeniceSkiaVersion>
  </PropertyGroup>

  <ItemGroup Label="Embedded Chromium">
    <PackageVersion Include="CefGlue.Next.Core" Version="156.8078.80" />
    <PackageVersion Include="cef.runtime.osx-x64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="cef.runtime.osx-arm64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="cef.runtime.win-x64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="cef.runtime.win-arm64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="cef.runtime.linux-x64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="cef.runtime.linux-arm64" Version="$(DeniceCefVersion)" />
    <PackageVersion Include="SkiaSharp" Version="$(DeniceSkiaVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="$(DeniceSkiaVersion)" />
    <PackageVersion Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Label="Best-practice analyzer suite">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.13.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="4.13.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.29.0.143774" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.125" />
    <PackageVersion Include="Philips.CodeAnalysis.DuplicateCodeAnalyzer" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="CLI command surface and version handling">
    <PackageVersion Include="System.CommandLine" Version="2.0.0" />
    <!-- Checks a downloaded release's cosign bundle (Tim, pkg-471f394bb261: "Use Sigstore"). MIT,
         github.com/mitchdenny/sigstore-dotnet; brings Tuf and BouncyCastle.Cryptography. -->
    <PackageVersion Include="Sigstore" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup Label="Roslyn analyzer authoring and testing">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <!-- ReportGenerator (the coverage report merge tool the gate runs) is pinned in the committed tool manifest
       .config/dotnet-tools.json (decision reportgenerator-pinned) and restored with `dotnet tool restore`, not
       package-referenced here — one pin, no drift. -->

</Project>
